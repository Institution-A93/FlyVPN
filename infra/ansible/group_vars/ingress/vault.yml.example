# Содержимое GitHub-секрета INGRESS_VAULT (на деплое → group_vars/ingress/vault.yml).
# Реальный vault.yml — в .gitignore (group_vars/*/vault.yml). На phase 2 подаёт оркестратор.
# Параметры Reality согласованы с egress (тот же keypair/shortId/uuid/SNI).

# --- Reality mesh: ingress (клиент) → egress (сервер) ---
ingress_egress_server: "EGRESS_PUBLIC_IP"          # публичный IP egress (Hetzner)
ingress_egress_port: 443
ingress_reality_uuid: "PUT-CLIENT-UUID"            # = один из egress_clients[].uuid
ingress_reality_public_key: "PUT-REALITY-PUBLIC"   # x25519 public (пара к egress_reality_private_key)
ingress_reality_short_id: "PUT-SHORT-ID"           # = один из egress_reality_short_ids
ingress_reality_server_name: "www.lovo.ai"         # SNI-камуфляж (= egress_reality_server_name)

# --- RADIUS → control plane ---
ingress_radius_server: "api.fly-vpn.net"           # адрес control (RADIUS auth/acct)
ingress_radius_secret: "PUT-RADIUS-SECRET"         # = secret в cp_radius_clients на control

# --- Let's Encrypt (серверный серт IKEv2 для vpn.fly-vpn.net) ---
ingress_le_email: "you@example.com"                # e-mail регистрации ACME (опц.)
