#!/bin/sh
# Сборка sing-box allowlist rule_set для walled garden (анти-локаут, ADR-0021):
# CIDR Telegram (официальный список). Расширяемо — позже добавить платёжные сервисы.
# DNS lapsed-юзеров идёт отдельным protocol-dns правилом, в allowlist не нужен.
set -eu
SRC_JSON="$(mktemp)"
CIDRS="$(mktemp)"
trap 'rm -f "$SRC_JSON" "$CIDRS"' EXIT

{% for url in ingress_allowlist_sources %}
curl -fsSL "{{ url }}" >> "$CIDRS" || true
{% endfor %}

# Только IPv4 CIDR/одиночные IP (грубый фильтр; IPv6 пока не маршрутизируем).
grep -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?' "$CIDRS" | sort -u > "$CIDRS.clean"

python3 - "$CIDRS.clean" > "$SRC_JSON" <<'PY'
import json, sys
cidrs=[l.strip() for l in open(sys.argv[1]) if l.strip()]
print(json.dumps({"version":1,"rules":[{"ip_cidr":cidrs}]}))
PY

/usr/local/bin/sing-box rule-set compile --output /var/lib/sing-box/allowlist.srs "$SRC_JSON"
echo "allowlist.srs обновлён: $(wc -l < "$CIDRS.clean") префиксов"
