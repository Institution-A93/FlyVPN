[Unit]
Description=account-api (веб-кабинет MVP: аккаунты, подписки, устройства, платежи Platega)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=smartinternet
EnvironmentFile=/etc/smartinternet/account-api.env
ExecStart=/usr/local/bin/account-api
Restart=on-failure
RestartSec=5
# Слушает :8080 (>1024) — CAP_NET_BIND_SERVICE не нужен. TLS/публичный домен — за reverse-proxy.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
