# Local dev only. Copy to .env (gitignored) and fill in.
# In production these come from systemd EnvironmentFile (/etc/flyvpn-bot/bot.env),
# rendered by the `bot` Ansible role from vault — never from a committed file.
BOT_TOKEN=

CABINET_URL=https://flynet.pro/login
SUPPORT_URL=https://t.me/flyvpn_support

NOTIFY_SECRET=dev-secret
NOTIFY_HOST=127.0.0.1
NOTIFY_PORT=8081

BRAND_NAME=FLY VPN
VPN_REMOTE=gw.flynet.pro
VPN_REMOTE_ID=gw.flynet.pro
